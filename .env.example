# SQLite for local development. Switch provider in prisma/schema.prisma
# to "postgresql" and point this at your managed Postgres for production.
DATABASE_URL="file:./dev.db"

# Random 32+ character secret used to sign session cookies.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. When unset, photos and PDFs are stored in ./uploads
S3_REGION="auto"
S3_ENDPOINT=""
S3_BUCKET="geodraftly-files"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional. When unset, the map uses OpenStreetMap tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=""
